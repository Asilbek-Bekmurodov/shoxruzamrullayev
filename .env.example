# Copy to .env (local) or set these in the Render dashboard (production).

# Admin panel password
ADMIN_PASSWORD=shoxruz123123

# Cloudinary — permanent file + metadata storage.
# Easiest: one URL from the Cloudinary dashboard ("API Environment variable").
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Or set the three separately instead of CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=<cloud_name>
# CLOUDINARY_API_KEY=<api_key>
# CLOUDINARY_API_SECRET=<api_secret>
